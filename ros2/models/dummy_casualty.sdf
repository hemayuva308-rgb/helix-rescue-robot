<?xml version="1.0"?>
<!-- A 75 kg dummy casualty (box 0.35 x 1.4 x 0.2 m, long side along y, to lie across the robot's forearms in a cradle carry).
     Inertia of a solid box: ixx = m/12 (y^2+z^2) = 12.5, iyy = m/12 (x^2+z^2) = 1.0156, izz = m/12 (x^2+y^2) = 13.016. -->
<sdf version="1.9">
  <model name="dummy_casualty">
    <link name="body">
      <inertial><mass>75</mass><inertia><ixx>12.5</ixx><iyy>1.0156</iyy><izz>13.016</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><box><size>0.35 1.4 0.2</size></box></geometry><surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface></collision>
      <visual name="v"><geometry><box><size>0.35 1.4 0.2</size></box></geometry><material><diffuse>0.9 0.5 0.2 1</diffuse></material></visual>
    </link>
  </model>
</sdf>
