<?xml version="1.0"?>
<!-- Gazebo Harmonic (gz sim) test world for the Helix robot. Not yet run: written for the next step of the project. -->
<sdf version="1.9">
  <world name="rescue_test">
    <physics name="fast" type="ignored"><max_step_size>0.002</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <gravity>0 0 -9.81</gravity>
    <light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><direction>-0.5 0.2 -0.9</direction></light>

    <model name="ground_plane"><static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry><material><ambient>0.35 0.37 0.4 1</ambient><diffuse>0.35 0.37 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <!-- a 10 cm step and a debris block to test stepping and collision -->
    <model name="step"><static>true</static><pose>2.5 0 0.05 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.6 2 0.1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.6 2 0.1</size></box></geometry><material><diffuse>0.5 0.45 0.4 1</diffuse></material></visual></link>
    </model>
    <model name="debris_block"><static>true</static><pose>4 0.6 0.15 0 0 0.3</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.5 0.4 0.3</size></box></geometry></collision><visual name="v"><geometry><box><size>0.5 0.4 0.3</size></box></geometry><material><diffuse>0.45 0.35 0.3 1</diffuse></material></visual></link>
    </model>
  </world>
</sdf>
